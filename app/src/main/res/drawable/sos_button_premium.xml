<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<item>
        <shape android:shape="oval">
            <solid android:color="#40D4A5A5"/>
<size
                android:width="240dp"
                android:height="240dp"/>
        </shape>
    </item>
<item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/cinematic_dark_primary"
                android:centerColor="#B6455B"
                android:endColor="@color/cinematic_light_primary"/>
        </shape>
    </item>

</layer-list>