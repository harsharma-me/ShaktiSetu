<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D42A2A">
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp">
<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shakti Setu"
            android:textSize="48sp"
            android:fontFamily="@font/bdscript_regular"
            android:textColor="#FFFFFF"
            android:layout_marginTop="40dp"/>
<ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_warning_triangle"
            android:layout_marginTop="20dp"/>
<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert Active"
            android:textSize="28sp"
            android:textStyle="bold|italic"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
<View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
<TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:textSize="120sp"
            android:textStyle="bold|italic"
            android:textColor="#FFFFFF"/>
<View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
<LinearLayout
            android:id="@+id/btnMuteSiren"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/btn_mute_siren"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_speaker"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MUTE SIREN"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
<TextView
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/btn_dismiss_outline"
            android:gravity="center"
            android:text="Dismiss Emergency"
            android:textSize="16sp"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</RelativeLayout>